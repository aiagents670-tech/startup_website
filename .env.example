# ═══════════════════════════════════════════════════════════════
# TERVOM Startup Website - Environment Variables
# ═══════════════════════════════════════════════════════════════
# Copy this file to .env.local and fill in your actual values

# ─────────────────────────────────────────────────────────────────
# SUPABASE CONFIGURATION (Required)
# ─────────────────────────────────────────────────────────────────
# Get these from https://supabase.com/dashboard/project/[project-id]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# ─────────────────────────────────────────────────────────────────
# SESSION MANAGEMENT (Required)
# ─────────────────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# MUST be at least 32 characters for security
SESSION_SECRET=your-secure-random-32-char-secret-here

# ─────────────────────────────────────────────────────────────────
# N8N WEBHOOK (Required for contact form automation)
# ─────────────────────────────────────────────────────────────────
# This should be kept SECRET - never commit it to version control
# Get from your n8n instance
N8N_WEBHOOK_URL=https://your-instance.app.n8n.cloud/webhook/your-workflow-id

# ─────────────────────────────────────────────────────────────────
# GOOGLE VERIFICATION & ANALYTICS (Optional)
# ─────────────────────────────────────────────────────────────────
# Google Search Console verification code
NEXT_PUBLIC_GOOGLE_VERIFICATION=your-google-site-verification-code

# Google Analytics ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX

# ─────────────────────────────────────────────────────────────────
# CORS & SECURITY (Optional)
# ─────────────────────────────────────────────────────────────────
# Allowed origin for CORS (defaults to * if not set)
ALLOWED_ORIGIN=https://yourdomain.com

# ─────────────────────────────────────────────────────────────────
# ADMIN CREDENTIALS (Development only - use Supabase auth in production)
# ─────────────────────────────────────────────────────────────────
# Hash this with bcrypt before using in production
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD_HASH=your-bcrypt-hash-here

# ═══════════════════════════════════════════════════════════════
# SETUP INSTRUCTIONS
# ═══════════════════════════════════════════════════════════════
#
# 1. Copy this file:
#    cp .env.example .env.local
#
# 2. Generate SESSION_SECRET:
#    openssl rand -base64 32
#
# 3. Fill in all REQUIRED variables
#
# 4. Start development server:
#    npm run dev
#
# 5. Never commit .env.local to git - it's already in .gitignore
#
# 6. In production, set these environment variables in your
#    deployment platform (Vercel, Netlify, etc.)
#
# ═══════════════════════════════════════════════════════════════
